<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="#CCFFFFFF"
            app:navigationIcon="@drawable/ic_menu_white"
            app:navigationIconTint="@color/white"/>

        <!-- Formatting toolbar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/toolbar_bg"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- B: 굵게 — textStyle 제거, 코드에서 SpannableString 설정 -->
                <Button
                    android:id="@+id/btnBold"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="B"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/bold"
                    android:checkable="true"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- I: 기울임 -->
                <Button
                    android:id="@+id/btnItalic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="I"
                    android:textStyle="italic"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/italic"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- U: 밑줄 — 코드에서 UnderlineSpan 설정 -->
                <Button
                    android:id="@+id/btnUnderline"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="U"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/underline"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- 글자색 -->
                <Button
                    android:id="@+id/btnTextColor"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="A"
                    android:textColor="#E53935"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="글자색"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- 크기 버튼 -->
                <Button
                    android:id="@+id/btnFontSize"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="크기"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/divider"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnAlignLeft"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="≡L"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/align_left"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <Button
                    android:id="@+id/btnAlignCenter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="≡C"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/align_center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <Button
                    android:id="@+id/btnAlignRight"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="≡R"
                    android:contentDescription="오른쪽 정렬"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- WebView editor -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- 이전/다음 챕터 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@color/toolbar_bg"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevChapter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="이전 챕터"
                android:textSize="13sp"
                android:contentDescription="이전 챕터"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnNextChapter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="다음 챕터"
                android:textSize="13sp"
                android:contentDescription="다음 챕터"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Bottom action bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/toolbar_bg"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/btnAddChapter"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/add_chapter"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnDeleteChapter"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/delete_chapter"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnInsertImage"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/insert_image"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnFont"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/font"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnToc"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/toc"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnImageGallery"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="이미지 목록"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnSave"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/save"
                    android:textSize="12sp"/>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── Navigation Drawer ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/chapters"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:background="@color/toolbar_bg"/>

        <!-- 챕터 검색 -->
        <EditText
            android:id="@+id/etChapterSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="챕터 검색..."
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/white"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chapterRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fastScrollEnabled="true"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
