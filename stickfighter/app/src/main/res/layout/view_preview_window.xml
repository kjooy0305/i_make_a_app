<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#E61F2A44"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/previewHeader"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/previewLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/previewSize"
                style="@style/ToolButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/preview_resize"
                android:src="@drawable/ic_stretch" />

            <ImageButton
                android:id="@+id/previewClose"
                style="@style/ToolButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <com.kjooy0305.stickfighter.ui.PlayerView
            android:id="@+id/previewPlayer"
            android:layout_width="220dp"
            android:layout_height="124dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/previewPlay"
                style="@style/ToolButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/pause"
                android:src="@drawable/ic_pause" />

            <SeekBar
                android:id="@+id/previewSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/previewScope"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/frame_bg"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
