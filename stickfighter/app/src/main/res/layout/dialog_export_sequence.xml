<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="@dimen/modify_figure_dialog_width"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <RelativeLayout
            android:id="@+id/exportingContainer"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_medium_small"
                android:textColor="@color/text_primary"
                android:id="@+id/exportingLabelTextView"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exporting_animation"/>
            <ProgressBar
                android:id="@+id/progressBarExporting"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:layout_below="@+id/exportingLabelTextView"
                style="@style/MaterialProgressBarHorizontal"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:gravity="center"
                android:id="@+id/cancelButton"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:layout_below="@+id/progressBarExporting"
                android:layout_alignParentRight="true"
                android:textAllCaps="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/finishedContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/labelContainer"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="@dimen/text_size_medium_small"
                    android:textColor="@color/text_primary"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_finished"/>
                <TextView
                    android:textSize="@dimen/text_size_tiny"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/finishedLabelTextView"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:textSize="@dimen/text_size_medium_small"
                    android:textColor="@color/text_primary"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_backup"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:gravity="center"
                android:id="@+id/shareButton"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:minWidth="48dp"
                android:text="@string/share"
                android:layout_below="@+id/labelContainer"
                android:layout_alignParentRight="true"
                android:textAllCaps="true"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:gravity="center"
                android:id="@+id/closeButton"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginRight="8dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/close"
                android:layout_toLeftOf="@+id/shareButton"
                android:layout_alignBottom="@+id/shareButton"
                android:textAllCaps="true"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
