<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/videoToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/playPauseContainer"
            android:background="@drawable/sequence_play_button"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/playPauseButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_action_play_arrow_white48dp"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"
                android:contentDescription="@string/content_description_play_pause"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/sequence_play_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_toRightOf="@+id/playPauseContainer"
            android:layout_alignBottom="@+id/playPauseContainer">
            <TextView
                android:gravity="right"
                android:id="@+id/playedDurationTextView"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                style="@style/VideoDurationTextView"/>
            <SeekBar
                android:id="@+id/playbackDurationSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"/>
            <TextView
                android:gravity="left"
                android:id="@+id/totalDurationTextView"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                style="@style/VideoDurationTextView"/>
            <ImageView
                android:id="@+id/videoSettingsButton"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_action_settings_white48dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/content_description_settings"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/videoSettingsMenuContainer"
        android:background="@color/white"
        android:padding="12dp"
        android:paddingBottom="0dp"
        android:visibility="invisible"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/text_secondary"
            android:id="@+id/fpsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/frames_per_second"/>
        <TextView
            android:id="@+id/fpsValueTextView"
            android:layout_below="@+id/fpsTextView"
            style="@style/VideoSettingValueTextView"/>
        <SeekBar
            android:id="@+id/playbackFpsSeekBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_toLeftOf="@+id/fpsValueTextView"
            android:layout_below="@+id/fpsTextView"
            android:layout_alignLeft="@+id/fpsTextView"/>
        <View
            android:id="@+id/topDivider"
            android:background="@color/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/playbackFpsSeekBar"
            android:layout_alignLeft="@+id/playbackFpsSeekBar"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/text_secondary"
            android:id="@+id/keyFpsLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/key_frames_per_second"
            android:layout_below="@+id/topDivider"
            android:layout_alignLeft="@+id/topDivider"/>
        <TextView
            android:id="@+id/keyFpsValueTextView"
            android:layout_below="@+id/keyFpsLabelTextView"
            style="@style/VideoSettingValueTextView"/>
        <SeekBar
            android:id="@+id/keyFpsSeekBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_toLeftOf="@+id/keyFpsValueTextView"
            android:layout_below="@+id/keyFpsLabelTextView"
            android:layout_alignLeft="@+id/keyFpsLabelTextView"/>
        <View
            android:id="@+id/middleDivider"
            android:background="@color/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/keyFpsSeekBar"
            android:layout_alignLeft="@+id/keyFpsSeekBar"/>
        <TextView
            android:textSize="@dimen/text_size_tiny"
            android:textColor="@color/text_secondary"
            android:id="@+id/repeatTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/repeat"
            android:layout_below="@+id/middleDivider"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/repeatSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/repeatTextView"/>
        <View
            android:id="@+id/bottomDivider"
            android:background="@color/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/repeatSwitch"
            android:layout_alignLeft="@+id/repeatTextView"/>
        <Button
            android:textColor="@color/accent"
            android:gravity="center"
            android:id="@+id/okButton"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="4dp"
            android:minWidth="48dp"
            android:minHeight="36dp"
            android:text="@string/apply"
            android:layout_below="@+id/bottomDivider"
            android:layout_alignParentRight="true"
            android:textAllCaps="true"/>
        <Button
            android:textColor="@color/accent"
            android:gravity="center"
            android:id="@+id/cancelButton"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:minWidth="48dp"
            android:minHeight="36dp"
            android:text="@string/cancel"
            android:layout_toLeftOf="@+id/okButton"
            android:layout_below="@+id/bottomDivider"
            android:textAllCaps="true"/>
    </RelativeLayout>
    <include layout="@layout/loading_frames_progress"/>
</RelativeLayout>
