<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="@dimen/modify_figure_dialog_width"
    android:layout_height="match_parent">
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/increaseButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_action_add_black48dp"
        android:scaleType="centerInside"
        android:tint="#ff727272"
        android:contentDescription="@string/content_description_increase_size"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="36sp"
            android:textColor="#ff454545"
            android:gravity="center"
            android:id="@+id/scaleFactorEditText"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:maxLength="3"
            android:layout_centerInParent="true"
            android:inputType="number"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/percent_mark"
            android:layout_toRightOf="@+id/scaleFactorEditText"
            android:layout_alignBaseline="@+id/scaleFactorEditText"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/decreaseButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_action_remove_black48dp"
        android:scaleType="centerInside"
        android:tint="#ff727272"/>
    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/content_description_decrease_size"/>
</LinearLayout>
