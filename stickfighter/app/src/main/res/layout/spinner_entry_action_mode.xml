<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/action_mode_selector_background"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="8dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iconImageView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="12dp"
        android:scaleType="centerInside"
        android:tint="@color/accent"
        android:contentDescription="@string/content_description_action_mode"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/text_primary"
        android:id="@+id/actionModeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_weight="1"/>
    <View
        android:id="@+id/actionModeCircleLeft"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="8dp"/>
    <View
        android:id="@+id/actionModeCircleRight"
        android:layout_width="10dp"
        android:layout_height="10dp"/>
    <ImageView
        android:id="@+id/imageViewHelp"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/ic_info_outline_black18dp"
        android:scaleType="centerInside"
        android:tint="#ff545454"
        android:contentDescription="@string/help"/>
</LinearLayout>
